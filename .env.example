# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Required for `npm run backup` (nightly database + upload backups over FTP).
BACKUP_FTP_HOST=ftp.yourdomain.com
BACKUP_FTP_USER=
BACKUP_FTP_PASSWORD=

# Optional — defaults shown.
# BACKUP_FTP_PORT=21
# BACKUP_FTP_SECURE=false
# BACKUP_FTP_DIR=/dm-notes-backups
# BACKUP_KEEP_LAST=14
